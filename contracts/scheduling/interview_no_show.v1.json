{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hirestream:contract:scheduling:interview_no_show:v1",
  "title": "scheduling-service interview_no_show v1",
  "description": "A party missed an interview (SPEC 7.2). Strict: what the producer promises (ADR-0014).",
  "type": "object",
  "properties": {
    "event_id": {
      "description": "UUIDv4; a duplicate delivery reuses it.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_type": {
      "type": "string",
      "const": "interview_no_show"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "source": {
      "type": "string",
      "const": "scheduling-service"
    },
    "producer_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"
    },
    "event_ts": {
      "description": "When the action occurred; ISO-8601 UTC with milliseconds and a Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$"
    },
    "sent_ts": {
      "description": "When the producer sent it; ISO-8601 UTC with milliseconds and a Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "interview_id": {
          "type": "string",
          "pattern": "^I[0-9]{9,}$"
        },
        "no_show_party": {
          "type": "string",
          "enum": [
            "candidate",
            "interviewer"
          ]
        }
      },
      "required": [
        "interview_id",
        "no_show_party"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source",
    "producer_version",
    "event_ts",
    "sent_ts",
    "payload"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "event_id": "e92c5ca4-405b-40c0-813a-23ab7e1444cd",
      "event_type": "interview_no_show",
      "schema_version": 1,
      "source": "scheduling-service",
      "producer_version": "1.3.1",
      "event_ts": "2025-02-10T21:30:00.000Z",
      "sent_ts": "2025-02-10T21:30:03.760Z",
      "payload": {
        "interview_id": "I000000267",
        "no_show_party": "interviewer"
      }
    }
  ]
}
