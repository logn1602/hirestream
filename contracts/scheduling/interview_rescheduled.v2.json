{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hirestream:contract:scheduling:interview_rescheduled:v2",
  "title": "scheduling-service interview_rescheduled v2",
  "description": "An interview moved to a new start (SPEC 7.2). Strict: what the producer promises (ADR-0014).",
  "type": "object",
  "properties": {
    "event_id": {
      "description": "UUIDv4; a duplicate delivery reuses it.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_type": {
      "type": "string",
      "const": "interview_rescheduled"
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "source": {
      "type": "string",
      "const": "scheduling-service"
    },
    "producer_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"
    },
    "event_ts": {
      "description": "When the action occurred; ISO-8601 UTC with milliseconds and a Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$"
    },
    "sent_ts": {
      "description": "When the producer sent it; ISO-8601 UTC with milliseconds and a Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "interview_id": {
          "type": "string",
          "pattern": "^I[0-9]{9,}$"
        },
        "previous_start": {
          "description": "Local ISO-8601 with its UTC offset, seconds precision (SPEC 7.2).",
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][+-](0[0-9]|1[0-4]):[0-5][0-9]$"
        },
        "new_start": {
          "description": "Local ISO-8601 with its UTC offset, seconds precision (SPEC 7.2).",
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][+-](0[0-9]|1[0-4]):[0-5][0-9]$"
        },
        "timezone": {
          "description": "IANA time zone of both starts.",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*$"
        },
        "reason": {
          "type": "string",
          "enum": [
            "candidate_conflict",
            "interviewer_conflict",
            "other"
          ]
        },
        "initiated_by": {
          "type": "string",
          "enum": [
            "candidate",
            "interviewer",
            "coordinator"
          ]
        }
      },
      "required": [
        "interview_id",
        "previous_start",
        "new_start",
        "timezone",
        "reason",
        "initiated_by"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source",
    "producer_version",
    "event_ts",
    "sent_ts",
    "payload"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "event_id": "d162387d-a13a-4e69-9dc2-6ddd7d13bb79",
      "event_type": "interview_rescheduled",
      "schema_version": 2,
      "source": "scheduling-service",
      "producer_version": "2.0.0",
      "event_ts": "2025-03-09T23:18:37.798Z",
      "sent_ts": "2025-03-09T23:18:41.968Z",
      "payload": {
        "interview_id": "I000000829",
        "previous_start": "2025-03-11T13:45:00-07:00",
        "new_start": "2025-03-17T15:30:00-07:00",
        "timezone": "America/Los_Angeles",
        "reason": "interviewer_conflict",
        "initiated_by": "interviewer"
      }
    }
  ]
}
