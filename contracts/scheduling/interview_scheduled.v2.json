{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hirestream:contract:scheduling:interview_scheduled:v2",
  "title": "scheduling-service interview_scheduled v2",
  "description": "An interview was booked (SPEC 7.2). Strict: what the producer promises (ADR-0014).",
  "type": "object",
  "properties": {
    "event_id": {
      "description": "UUIDv4; a duplicate delivery reuses it.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_type": {
      "type": "string",
      "const": "interview_scheduled"
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "source": {
      "type": "string",
      "const": "scheduling-service"
    },
    "producer_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"
    },
    "event_ts": {
      "description": "When the action occurred; ISO-8601 UTC with milliseconds and a Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$"
    },
    "sent_ts": {
      "description": "When the producer sent it; ISO-8601 UTC with milliseconds and a Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "interview_id": {
          "type": "string",
          "pattern": "^I[0-9]{9,}$"
        },
        "application_id": {
          "type": "string",
          "pattern": "^A[0-9]{9,}$"
        },
        "req_id": {
          "type": "string",
          "pattern": "^R[0-9]{6,}$"
        },
        "interview_type": {
          "type": "string",
          "enum": [
            "phone_screen",
            "onsite"
          ]
        },
        "loop_id": {
          "description": "Null for a phone screen.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^L[0-9]{8,}$"
        },
        "session_index": {
          "description": "Null for a phone screen.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "interviewer_ids": {
          "description": "One or more distinct interviewers; a panel has two (ADR-0011).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^E[0-9]{6,}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "scheduled_start": {
          "description": "Local ISO-8601 with its UTC offset, seconds precision (SPEC 7.2).",
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][+-](0[0-9]|1[0-4]):[0-5][0-9]$"
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "timezone": {
          "description": "IANA time zone of scheduled_start.",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*$"
        },
        "coordinator_id": {
          "type": "string",
          "pattern": "^E[0-9]{6,}$"
        },
        "interview_format": {
          "description": "Added in v2 (SPEC 7.2).",
          "type": "string",
          "enum": [
            "virtual",
            "in_person"
          ]
        }
      },
      "required": [
        "interview_id",
        "application_id",
        "req_id",
        "interview_type",
        "loop_id",
        "session_index",
        "interviewer_ids",
        "scheduled_start",
        "duration_minutes",
        "timezone",
        "coordinator_id",
        "interview_format"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "interview_type": {
                "const": "phone_screen"
              }
            },
            "required": [
              "interview_type"
            ]
          },
          "then": {
            "properties": {
              "loop_id": {
                "type": "null"
              },
              "session_index": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "interview_type": {
                "const": "onsite"
              }
            },
            "required": [
              "interview_type"
            ]
          },
          "then": {
            "properties": {
              "loop_id": {
                "type": "string"
              },
              "session_index": {
                "type": "integer"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source",
    "producer_version",
    "event_ts",
    "sent_ts",
    "payload"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "event_id": "459bcf1a-1a08-4d94-be8c-96a37127c3e2",
      "event_type": "interview_scheduled",
      "schema_version": 2,
      "source": "scheduling-service",
      "producer_version": "2.0.0",
      "event_ts": "2025-02-14T15:21:02.641Z",
      "sent_ts": "2025-02-14T15:21:03.012Z",
      "payload": {
        "interview_id": "I000000445",
        "application_id": "A000001352",
        "req_id": "R000009",
        "interview_type": "phone_screen",
        "loop_id": null,
        "session_index": null,
        "interviewer_ids": [
          "E000134"
        ],
        "scheduled_start": "2025-02-18T12:45:00+05:30",
        "duration_minutes": 45,
        "timezone": "Asia/Kolkata",
        "coordinator_id": "E000185",
        "interview_format": "virtual"
      }
    },
    {
      "event_id": "c9df10c8-473b-40f4-95f1-49ef3456dc96",
      "event_type": "interview_scheduled",
      "schema_version": 2,
      "source": "scheduling-service",
      "producer_version": "2.0.0",
      "event_ts": "2025-02-14T09:54:10.375Z",
      "sent_ts": "2025-02-14T09:54:14.192Z",
      "payload": {
        "interview_id": "I000000458",
        "application_id": "A000001030",
        "req_id": "R000003",
        "interview_type": "onsite",
        "loop_id": "L00000056",
        "session_index": 2,
        "interviewer_ids": [
          "E000058",
          "E000134"
        ],
        "scheduled_start": "2025-02-25T14:00:00+00:00",
        "duration_minutes": 60,
        "timezone": "Europe/London",
        "coordinator_id": "E000150",
        "interview_format": "in_person"
      }
    }
  ]
}
