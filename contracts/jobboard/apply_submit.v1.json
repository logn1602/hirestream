{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hirestream:contract:jobboard:apply_submit:v1",
  "title": "jobboard-web apply_submit v1",
  "description": "A visitor submitted an application (SPEC 7.3). Strict: what the producer promises (ADR-0014).",
  "type": "object",
  "properties": {
    "event_id": {
      "description": "UUIDv4; a duplicate delivery reuses it.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_type": {
      "type": "string",
      "const": "apply_submit"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "source": {
      "type": "string",
      "const": "jobboard-web"
    },
    "producer_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"
    },
    "event_ts": {
      "description": "Epoch milliseconds (SPEC 7.1); the minimum rules out seconds.",
      "type": "integer",
      "minimum": 1000000000000
    },
    "sent_ts": {
      "description": "When the producer sent it; ISO-8601 UTC with milliseconds and a Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$"
    },
    "context": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^s-[0-9a-f]{12}$"
        },
        "visitor_id": {
          "type": "string",
          "pattern": "^v-[0-9a-f]{12}$"
        },
        "employee_id": {
          "description": "Set only for internal visitors.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^E[0-9]{6,}$"
        },
        "user_agent": {
          "type": "string",
          "minLength": 1
        },
        "referrer_type": {
          "type": "string",
          "enum": [
            "direct",
            "search_engine",
            "social",
            "email",
            "internal_portal"
          ]
        }
      },
      "required": [
        "session_id",
        "visitor_id",
        "employee_id",
        "user_agent",
        "referrer_type"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "req_id": {
          "type": "string",
          "pattern": "^R[0-9]{6,}$"
        },
        "application_id": {
          "type": "string",
          "pattern": "^A[0-9]{9,}$"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^C[0-9]{8,}$"
        }
      },
      "required": [
        "req_id",
        "application_id",
        "candidate_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source",
    "producer_version",
    "event_ts",
    "sent_ts",
    "context",
    "payload"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "event_id": "fe480bea-0995-46a0-a609-bb30a11a6a0e",
      "event_type": "apply_submit",
      "schema_version": 1,
      "source": "jobboard-web",
      "producer_version": "3.2.0",
      "event_ts": 1738116247425,
      "sent_ts": "2025-01-29T02:04:12.232Z",
      "context": {
        "session_id": "s-dba4aa01832c",
        "visitor_id": "v-09bc4e275002",
        "employee_id": null,
        "user_agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36",
        "referrer_type": "social"
      },
      "payload": {
        "req_id": "R000001",
        "application_id": "A000001070",
        "candidate_id": "C00000998"
      }
    }
  ]
}
