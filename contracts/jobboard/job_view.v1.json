{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hirestream:contract:jobboard:job_view:v1",
  "title": "jobboard-web job_view v1",
  "description": "A visitor opened a job (SPEC 7.3). Strict: what the producer promises (ADR-0014).",
  "type": "object",
  "properties": {
    "event_id": {
      "description": "UUIDv4; a duplicate delivery reuses it.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_type": {
      "type": "string",
      "const": "job_view"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "source": {
      "type": "string",
      "const": "jobboard-web"
    },
    "producer_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"
    },
    "event_ts": {
      "description": "Epoch milliseconds (SPEC 7.1); the minimum rules out seconds.",
      "type": "integer",
      "minimum": 1000000000000
    },
    "sent_ts": {
      "description": "When the producer sent it; ISO-8601 UTC with milliseconds and a Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$"
    },
    "context": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^s-[0-9a-f]{12}$"
        },
        "visitor_id": {
          "type": "string",
          "pattern": "^v-[0-9a-f]{12}$"
        },
        "employee_id": {
          "description": "Set only for internal visitors.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^E[0-9]{6,}$"
        },
        "user_agent": {
          "type": "string",
          "minLength": 1
        },
        "referrer_type": {
          "type": "string",
          "enum": [
            "direct",
            "search_engine",
            "social",
            "email",
            "internal_portal"
          ]
        }
      },
      "required": [
        "session_id",
        "visitor_id",
        "employee_id",
        "user_agent",
        "referrer_type"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "req_id": {
          "type": "string",
          "pattern": "^R[0-9]{6,}$"
        },
        "position_in_results": {
          "description": "Null when the visitor did not come from a search.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "req_id",
        "position_in_results"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source",
    "producer_version",
    "event_ts",
    "sent_ts",
    "context",
    "payload"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "event_id": "6f651f5d-eb8a-4624-a198-c861990b4901",
      "event_type": "job_view",
      "schema_version": 1,
      "source": "jobboard-web",
      "producer_version": "3.2.0",
      "event_ts": 1735674279492,
      "sent_ts": "2024-12-31T19:44:43.506Z",
      "context": {
        "session_id": "s-26008bb8bd0d",
        "visitor_id": "v-2afc6f5c2055",
        "employee_id": null,
        "user_agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 14_6) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.6 Safari/605.1.15",
        "referrer_type": "direct"
      },
      "payload": {
        "req_id": "R000001",
        "position_in_results": 2
      }
    }
  ]
}
