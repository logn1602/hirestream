# Copy to .env (gitignored) and replace every change-me value: cp .env.example .env
# Keys are documented in docs/SPEC.md §5.1.

# --- Pipeline ---
HIRESTREAM_ENV=local
# HIRESTREAM_LAKE_ROOT=./data/lake
# Required from T2.x. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
HIRESTREAM_PII_SALT=change-me
# Optional alert sink.
HIRESTREAM_SLACK_WEBHOOK=
# Cloud mode only (IAM Identity Center profile).
# AWS_PROFILE=hirestream

# Host ports sit in the 15xxx range to avoid clashing with a native Postgres on 5432/5433.

# --- ats-db: simulated vendor ATS (host port) ---
# `make generate` loads the ATS here (ADR-0009). HIRESTREAM_ATS_DSN, if set, overrides these.
# HIRESTREAM_ATS_DSN=
ATS_DB_NAME=ats
ATS_DB_USER=ats
ATS_DB_PASSWORD=change-me
ATS_DB_PORT=15432

# --- warehouse-db: local warehouse (host port) ---
WAREHOUSE_DB_NAME=warehouse
WAREHOUSE_DB_USER=warehouse
WAREHOUSE_DB_PASSWORD=change-me
WAREHOUSE_DB_PORT=15433

# --- metabase (host port) ---
METABASE_PORT=3000
